# Supabase — lấy từ Project Settings > API sau khi tạo project tại supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# BÍ MẬT — chỉ dùng server-side, không commit, không đưa cho giáo viên, không để chung dòng với key
SUPABASE_SERVICE_ROLE_KEY=

# Bảo vệ endpoint cron giữ ấm Supabase (tự sinh 1 chuỗi ngẫu nhiên bất kỳ)
CRON_SECRET=change-me

# ---- Dùng cho pipeline/ (không cần trong web app) ----
# Xem pipeline/LLM_PROVIDERS.md để biết phân tích free tier / quota / bảo mật chi tiết.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# auto (mặc định, ưu tiên Gemini free + tự fallback DeepSeek khi hết quota) | gemini | deepseek
LLM_PROVIDER=auto
